{
  "name": "three-wasm-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rust WASM 场景图、WebGL2 渲染与 Three.js 对照实验",
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg --release -- --locked",
    "dev": "npm run build:wasm && vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:rust": "cargo test --locked",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:rust && npm run build:wasm && npm run test:integration && npm run test:e2e",
    "check": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "vite": "6.4.4",
    "wasm-pack": "0.15.0"
  },
  "engines": { "node": ">=20.19.0" }
}
