{
  "name": "three-wasm-rust",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Rust/WASM 场景引擎与 Three.js 完整流程对照",
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg --release -- --locked",
    "dev": "npm run build:wasm && vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:wasm && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:rust": "cargo test --locked",
    "test:integration": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:rust && npm run build:wasm && npm run typecheck && npm run test:integration && npm run test:e2e",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.node.json",
    "check": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.4",
    "wasm-pack": "0.15.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
